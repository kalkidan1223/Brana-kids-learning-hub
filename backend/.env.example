            PORT=5000
NODE_ENV=development

# Optional private Python/Scikit-learn inference service. Keep this token
# server-side; never copy it into frontend environment variables.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=replace_with_a_long_random_internal_secret
ML_STRUGGLE_THRESHOLD=0.60

# PostgreSQL
DATABASE_URL=postgresql://postgres:4512@localhost:5432/learning_hub
# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin allowed to make credentialed requests
CLIENT_ORIGIN=http://localhost:5173

# Amharic Fidel TTS Configuration
# Options: edge (Microsoft Neural - default & zero-cost), azure (Azure Cognitive Speech), mock (offline test provider)
TTS_PROVIDER=edge
# Required only if TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Email/SMTP Configuration

# Google OAuth
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
